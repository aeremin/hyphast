rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The owner is always a member, so the workspace can be bootstrapped; other members
    // are added from the Settings page (members/{lowercased email}).
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (myEmail() == 'a.eremin.msu@gmail.com'
          || exists(/databases/$(database)/documents/members/$(myEmail())));
    }

    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }

    // Keep in sync with NodeFields and the MAX_* constants in functions/src/model.ts.
    function validNode(d) {
      return d.keys().hasOnly([
          'kind', 'title', 'notes', 'status', 'parentId', 'assignee', 'due',
          'blockedBy', 'related', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && d.kind in ['area', 'project', 'task']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 500
        && d.notes is string && d.notes.size() <= 50000
        && d.status in ['todo', 'in_progress', 'done', 'dropped']
        && (d.parentId == null || d.parentId is string)
        && (d.kind == 'area') == (d.parentId == null)
        && optString(d, 'assignee', 320)
        && (d.due == null || (d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.blockedBy is list && d.blockedBy.size() <= 100
        && d.related is list && d.related.size() <= 100
        && d.updatedBy == myEmail();
    }

    match /members/{email} {
      allow read: if isMember();
      allow create, update: if isMember()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'addedBy', 'addedAt'])
        && optString(request.resource.data, 'name', 200)
        && optString(request.resource.data, 'photoURL', 2000);
      allow delete: if isMember();
    }

    match /nodes/{nodeId} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validNode(request.resource.data);
    }

    // API tokens for the MCP server. The id is the SHA-256 of the token; the token itself is
    // shown once when it's created and never stored.
    match /apiTokens/{hash} {
      allow read, delete: if isMember() && resource.data.email == myEmail();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt', 'lastUsedAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string && request.resource.data.name.size() <= 200;
    }
  }
}
